# pnpm verifies its own identity against the "packageManager" field in
# package.json and switches to that exact build. From 11.1.x pnpm stopped
# publishing an Intel-Mac binary — @pnpm/exe@11.1.3 has macos-arm64 but no
# macos-x64 — so on an Intel Mac that switch cannot succeed and every command
# dies before it starts:
#
#   ERR_PNPM_PNPM_ENGINE_NO_NATIVE_BINARY
#   Cannot run @pnpm/exe@11.1.3 on this host: it ships no native binary for
#   darwin-x64.
#
# "ignore" skips the switch and uses whichever pnpm is installed. The plain
# `pnpm` npm package is pure JavaScript (os: any, cpu: any), so it runs
# everywhere Node does — including the platform the native build skips.
#
# The version pin stays meaningful: everyone still installs 11.1.3, it just is
# not re-verified through a binary that does not exist for their machine.
pm-on-fail=ignore
