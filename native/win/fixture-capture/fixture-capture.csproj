<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows (not plain net8.0): FlaUI.Core/FlaUI.UIA3 reference
         WinForms/WPF-adjacent packages, which NETSDK1136 refuses to build
         against a non-Windows-suffixed TFM. Same root cause confirmed by a
         real CI build failure against these same packages in
         native/win/spike/flaui-variant — not a guess. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Deliberately NOT AOT — this is a manually-run collection tool for a
         colleague, not the shipped resolver. Startup time and binary size
         don't matter here; using FlaUI's easier API regardless of what the
         C.0 spike concludes about AOT compatibility is the right call for a
         throwaway data-collection utility. Self-contained trimmed is enough
         for "hand someone a .exe with nothing to install". -->
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

</Project>
