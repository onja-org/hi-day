<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Pinned name: desktop/src/main/url-capture/protocol.ts's own file
         header comment names this side-car win-resolver.exe. -->
    <AssemblyName>win-resolver</AssemblyName>
    <RootNamespace>WinResolver</RootNamespace>
    <!-- net8.0-windows (not plain net8.0): Stage C.2 adds FlaUI.Core /
         FlaUI.UIA3, which require the Windows-suffixed TFM (see the
         NETSDK1136 fix history in native/win/spike/flaui-variant). Set
         here now so C.2 is just a package reference, not a TFM change. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Deliberately NOT AOT, NOT trimmed — native/win/spike/RESULTS.md
         found both incompatible with the classic COM interop UIA reading
         needs (InvalidProgramException under AOT; built-in COM disabled
         entirely under trimming). Ship as a plain self-contained build. -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinResolver.Core\WinResolver.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions unverified — no dotnet SDK/network access to resolve
         these locally. If CI reports a resolution failure, bump to
         whatever the latest stable 4.x release actually is (same caveat
         as native/win/spike/flaui-variant.csproj). -->
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked (not copied) from their single source of truth, so there is
         exactly one place to add a browser or a locale marker — never
         edit the copies that land in the output directory below. -->
    <None Include="..\..\..\..\desktop\src\main\url-capture\browser-registry.json"
          Link="browser-registry.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\desktop\src\main\resolvers\darwin\firefox-private-markers.json"
          Link="firefox-private-markers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
