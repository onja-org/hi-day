<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- References Core only, not the WinResolver console app project —
         Core has zero P/Invoke/Windows-specific code, so this test
         project builds and runs on any platform. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions unverified — no dotnet SDK/network access to resolve
         these locally. If CI reports a resolution failure, bump to
         whatever the latest stable release actually is (same caveat as
         native/win/spike/flaui-variant.csproj's FlaUI version). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinResolver.Core\WinResolver.Core.csproj" />
  </ItemGroup>

</Project>
