<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0, no RID, no Windows suffix: this project holds only
         the wire-protocol DTOs and pure request-parsing logic — no
         P/Invoke, no COM, nothing Windows-specific — so it (and its test
         project) can be built and tested on any platform, including CI
         runners other than windows-latest. The actual Windows-only glue
         (focus hook, integrity-level check, Program.cs) lives in the
         sibling WinResolver project instead. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WinResolver.Core</RootNamespace>
  </PropertyGroup>

</Project>
