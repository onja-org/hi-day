<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for hardened runtime notarized distribution — see
  docs/url-tracking-permissions.md for what each gate needs and why.

  The first four are the standard set Electron's own notarization docs
  require for ANY hardened-runtime Electron app (not specific to url
  tracking): Chromium's V8 needs JIT and unsigned-executable-memory:
  disable-library-validation matters here specifically because this app
  now bundles third-party native code not signed by the same certificate
  (better-sqlite3's compiled addon, and the separate firefox-ax-helper
  binary) — without it, hardened runtime refuses to load them.

  com.apple.security.automation.apple-events is NOT accepted for Mac App
  Store distribution — this is why the plan (docs/url-tracking-plan.md
  Step 11) commits to direct, notarized distribution instead of the MAS,
  not a choice that can be revisited later without dropping Apple Events
  entirely.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
