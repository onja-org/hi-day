{
  "name": "desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Workforce Monitor desktop agent (login, device registration, and start/stop time tracking)",
  "homepage": "https://github.com/onja-org/workfoce-monitoring-app",
  "author": "Rinon <rinon.ten@onja.org>",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "dev": "pnpm build && pnpm rebuild:electron && electron .",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "drills": "vitest run src/main/url-capture/tests/failure-drills.spec.ts src/main/url-capture/tests/acceptance-criteria.spec.ts --reporter=verbose",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:mac": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "dbus-next": "^0.10.2",
    "tldts": "^7.4.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "globals": "^17.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.1.3"
}
