# Origin of the backend API. Server-only (no NEXT_PUBLIC_ prefix): used by
# next.config.ts to proxy /api/backend/* to the real backend (so the browser
# only ever talks to this frontend's own origin, keeping the backend's
# session cookies same-origin) and by isAuthenticated.ts for its direct
# server-to-server session check.
BACKEND_ORIGIN=http://localhost:3001

# reCAPTCHA v2 (checkbox) site key, shown after repeated failed login attempts.
# The value below is Google's published, always-succeeds TEST site key — fine
# for local dev, but replace with your own site's real site key (paired with
# the matching real RECAPTCHA_SECRET_KEY on the backend) before deploying anywhere real.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
