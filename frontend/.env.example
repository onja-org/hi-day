# Hi Day web console configuration.
#
#   cp .env.example .env
#
# Only BACKEND_ORIGIN is required. There is deliberately no billing switch
# here: the browser asks the backend at runtime (GET /config), so one built
# frontend serves both a self-hosted install and Hi Day Cloud.
#
# Running under Docker? Use ../.env.docker.example instead.

# Origin of the backend API. Server-only (no NEXT_PUBLIC_ prefix): used by
# next.config.ts to proxy /api/backend/* to the real backend (so the browser
# only ever talks to this frontend's own origin, keeping the backend's
# session cookies same-origin) and by isAuthenticated.ts for its direct
# server-to-server session check.
BACKEND_ORIGIN=http://localhost:3001

# reCAPTCHA v2 (checkbox) site key, shown after repeated failed login attempts.
# The value below is Google's published, always-succeeds TEST site key — fine
# for local dev, but replace with your own site's real site key (paired with
# the matching real RECAPTCHA_SECRET_KEY on the backend) before deploying anywhere real.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# CLOUD-ONLY (hiday.io). Leave blank when self-hosting.
#
# Stripe Elements draws the in-app payment modal. Publishable keys are
# public by design — they ship in the browser bundle — so this is the one
# Stripe key that belongs in NEXT_PUBLIC_. The secret key stays backend-only.
#
# There is deliberately no billing on/off switch here. The frontend asks the
# backend at runtime (GET /config), so one built frontend serves both a
# self-hosted install and Hi Day Cloud with no rebuild. The switch is
# BILLING_ENABLED in backend/.env.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
