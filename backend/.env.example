# Hi Day backend configuration.
#
#   cp .env.example .env
#
# Only four settings are required: DATABASE_URL, JWT_SECRET, FRONTEND_URL
# and CORS_ORIGIN. Everything else has a working default or is optional, and
# anything marked CLOUD-ONLY exists for hiday.io and should stay blank on a
# self-hosted install.
#
# Running under Docker? Use ../.env.docker.example instead — docker-compose
# passes these in for you.

# ---------------------------------------------------------------------------
# Core — required
# ---------------------------------------------------------------------------

# Port the NestJS API listens on
PORT=3001

# Origin allowed to call this API (the frontend's URL)
CORS_ORIGIN=http://localhost:3000

# Postgres connection string — point this at your own local Postgres server.
# Update the user/password/port/db name to match how Postgres is set up on your machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workforce_monitoring?schema=public"

# Secret used to sign access-token JWTs. Generate a long random value per environment.
JWT_SECRET=change-me-to-a-long-random-value

# Access-token lifetime, in days. Also sets the access-token cookie's
# max-age, so the JWT's own exp claim and the cookie can't drift out of sync.
ACCESS_TOKEN_TTL_DAYS=14

# Refresh-token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Email — OPTIONAL
# ---------------------------------------------------------------------------
#
# Leave both blank and Hi Day still works. Every message that would have
# been sent is written to this server's log instead, marked "was not sent",
# with its link on its own line — and an invitation's join link is also
# shown in the app to the admin who created it, with a copy button.
#
# That matters because setting a first password, accepting an invitation and
# confirming a deletion are each only completable through a one-time link.
# Requiring an account with a third-party provider before the app will start
# would make "free to self-host" untrue.
#
# To send real email: sign up at https://resend.com, verify a sending
# domain, then set both of these and restart.
RESEND_API_KEY=

# "From" address used on outbound emails. Must be on a domain your provider
# has verified. Only used when RESEND_API_KEY is set.
EMAIL_SENDER=

# Base URL of the frontend — used to build links inside emails (e.g. the email-verification link).
FRONTEND_URL=http://localhost:3000

# How long an invitation's accept link stays valid, in hours.
INVITATION_TTL_HOURS=72

# reCAPTCHA v2 secret key, used to verify the checkbox challenge shown to a
# login attempt after repeated failures (see LoginAttemptTracker/CaptchaService).
# The value below is Google's published, always-succeeds TEST secret key —
# fine for local dev, but it verifies nothing. Replace with your own site's
# real secret key (from google.com/recaptcha) before deploying anywhere real.
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# How long a device can go without a heartbeat (or login) before the admin
# console shows it as Offline instead of Active, in minutes.
DEVICE_HEARTBEAT_WINDOW_MINUTES=5

# ---------------------------------------------------------------------------
# Screenshot storage — OPTIONAL
# ---------------------------------------------------------------------------
#
# Any S3-compatible object storage (Wasabi, Backblaze B2, MinIO, AWS S3).
# Where screenshots actually live: the desktop agent uploads image bytes
# straight there via a presigned URL, and the API only ever stores the
# resulting object key (see docs/adr/0012-...).
#
# Leave all five blank and everything else still works — time tracking,
# projects, activity, apps and URLs, reports and the desktop agent. Only
# screenshots are unavailable, and the server says so once at start-up.
#
# All five or none: one missing value is a misconfiguration rather than a
# deliberate opt-out, and is treated as none.
WASABI_REGION=
WASABI_ENDPOINT=
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_BUCKET=

# How long a presigned screenshot URL (the agent's upload PUT, or the web
# console's viewing GET) stays valid before it expires, in seconds.
SCREENSHOT_URL_TTL_SECONDS=300

# Days a deleted organisation stays suspended (and restorable by its owner)
# before its data is permanently purged.
ORGANISATION_DELETION_GRACE_DAYS=30

# How long the emailed "confirm account deletion" link stays valid, in hours.
ORGANISATION_DELETION_CONFIRMATION_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------

# Whether this installation bills anyone at all.
#
# OFF BY DEFAULT, and self-hosting means leaving it that way: Hi Day is free
# forever for any team size when you run it yourself, so an empty .env is
# already a correct self-hosted install. Nothing below this line is needed,
# or read, while it is off.
#
# With it off there is no trial and no countdown banner, no Billing section
# in Settings (the routes are not registered — they 404, not merely hidden),
# no seat consent in the invite forms, no seat sync, no reminder emails, and
# no Stripe configuration required to boot.
#
# Hi Day Cloud sets this to "true". Only the exact string "true" counts —
# "1", "yes" and a typo all read as off, deliberately: switching billing on
# by accident shows somebody a paywall we promised them they would never see.
#
# This is the only switch — the frontend has none. It reads the answer at
# runtime from GET /config, so one built frontend image serves both shapes
# and there is nothing to keep in sync.
BILLING_ENABLED=false

# CLOUD-ONLY (hiday.io). Ignored when BILLING_ENABLED is off.
#
# Organisations that never pay, by publicId (the 6-digit number in URLs),
# comma-separated. Onja's own workspace belongs here. They get no trial
# countdown, no reminder emails, and are never billed. Config rather than a
# database column so changing who is free is a config change and a restart,
# not a migration or a command run against production — and so a billing
# outage can never lock us out of our own product. Leave empty for none.
BILLING_FREE_ORGANISATION_IDS=

# CLOUD-ONLY (hiday.io). Leave all of these blank when self-hosting.
#
# Stripe, test-mode keys in development. Only read when BILLING_ENABLED is
# "true" — and then STRIPE_SECRET_KEY is REQUIRED: billing on without a key
# refuses to boot rather than degrading into a deploy that looks healthy,
# shows an "Add payment" button leading nowhere, and silently stops syncing
# seats. Leave all of these blank for a self-hosted install.
#
# No Price objects need creating: the amounts are passed inline from
# billing/pricing.ts, which is the single source for what is charged.
#
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to localhost:3001/billing/webhook`,
# which is the route that records what Stripe says. That route is deliberately
# outside every guard — Stripe has no session — and is authenticated by the
# signature over the raw body instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe Product every charge hangs off; its name is what a customer
# sees on the invoice. Amounts are passed inline from billing/pricing.ts, so
# no Price object needs creating in the dashboard — only this.
#
# Optional: left blank, the first charge finds a Product by name or creates
# one. Worth pinning in production — the id never changes, and it skips a
# search that is eventually consistent.
STRIPE_PRODUCT_ID=

# Where the public "Talk to us" form sends messages. Server-only (no
# NEXT_PUBLIC_ prefix): the browser never learns the address. Uses the same
# RESEND_API_KEY as every other email.
CONTACT_RECIPIENT_EMAIL=
