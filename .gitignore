.vercel
.env*
!.env.example

# dependencies (yarn workspaces hoist to the root)
node_modules/

# build outputs
dist/
build/
.next/
out/
release/

# ...except desktop/build/, which is electron-builder's conventional
# location for source assets (entitlements, icons) — not compiled output.
!desktop/build/
!desktop/build/**

# Swift Package Manager build output, and the compiled universal binary
# build.sh copies out of it — both are build artifacts, not source.
desktop/native/darwin/firefox-ax-helper-swift/.build/
desktop/native/darwin/firefox-ax-helper

# .NET build output (native/win's resolver side-car and the C.0 spike).
# obj/ embeds absolute machine paths and NuGet restore assets, bin/ holds
# compiled binaries — neither is source, and both are regenerated by
# `dotnet build`. Scoped to native/win rather than a bare bin//obj/ so a
# directory legitimately named bin elsewhere in the repo is unaffected.
native/win/**/bin/
native/win/**/obj/

# turborepo
.turbo/

# Python (native/linux's resolver side-car)
__pycache__/
*.pyc

# editor
.idea/
.vscode/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
