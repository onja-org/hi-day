.vercel
.env*
!.env.example

# dependencies (yarn workspaces hoist to the root)
node_modules/

# build outputs
dist/
build/
.next/
out/
release/

# ...except desktop/build/, which is electron-builder's conventional
# location for source assets (entitlements, icons) — not compiled output.
!desktop/build/
!desktop/build/**

# Swift Package Manager build output, and the compiled universal binary
# build.sh copies out of it — both are build artifacts, not source.
desktop/native/darwin/firefox-ax-helper-swift/.build/
desktop/native/darwin/firefox-ax-helper

# turborepo
.turbo/

# editor
.idea/
.vscode/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
