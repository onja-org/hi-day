# Copy to .env and fill in the two required values:
#
#   cp .env.docker.example .env
#   docker compose up --build
#
# This file is only read by docker compose. The per-package .env.example
# files are for running Hi Day without Docker.

# --- required ---------------------------------------------------------

# The database password. Any strong string; it is used only inside the
# compose network.
POSTGRES_PASSWORD=

# Signs session tokens. Generate one and keep it:
#   openssl rand -base64 48
# Changing it signs everybody out.
JWT_SECRET=

# --- usually fine as they are -----------------------------------------

# Where people reach Hi Day. Change this to your real address before
# anybody but you uses it — invitation and password links are built from
# it, so "localhost" links will not work for anyone else.
APP_URL=http://localhost:3000

APP_PORT=3000
BACKEND_PORT=3001
POSTGRES_USER=hiday
POSTGRES_DB=hiday

# --- optional ---------------------------------------------------------

# Email. Leave everything here blank and Hi Day still works: invitation and
# password-reset links are printed to the backend log and shown in the app
# to the admin who created them. The one real cost is that an ordinary
# member cannot reset their own password — see the README.
#
# Two ways to turn it on. SMTP wins if both are set.
#
# 1. SMTP — your own mail server. No new account anywhere. Gmail and
#    Microsoft 365 need an APP PASSWORD, not the account password. Leave
#    SMTP_USER and SMTP_PASSWORD blank for a relay that wants no login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Normally leave blank — inferred from the port (true for 465, else false).
SMTP_SECURE=
# Only for an internal server with a self-signed certificate.
SMTP_ALLOW_SELF_SIGNED=

# 2. Resend — a hosted API (https://resend.com). Needs a domain you control
#    and can add DNS records to before it will send to anyone but you.
RESEND_API_KEY=

# "From" address, for either option. Must be one the mail system accepts.
EMAIL_SENDER=

# Screenshot capture, through any S3-compatible storage. Leave blank and
# every other feature still works; screenshots simply are not stored.
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_BUCKET=
WASABI_REGION=
WASABI_ENDPOINT=

# Screenshot URL lifetime, in seconds. Only read when the WASABI_* settings
# above are filled in.
SCREENSHOT_URL_TTL_SECONDS=300

# reCAPTCHA, shown after repeated failed logins. Leave blank and that
# challenge is simply never raised. The site key is public and inlined into
# the browser bundle at image build time, so changing it needs
# `docker compose up --build`.
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Where the public "Talk to us" form sends messages. Leave blank and the
# form accepts nothing.
CONTACT_RECIPIENT_EMAIL=

# Session lifetimes, in days, and how long an invitation link stays valid.
ACCESS_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_HOURS=72

# --- cloud-only (hiday.io) --------------------------------------------
#
# SELF-HOSTING? LEAVE ALL OF THIS ALONE. Hi Day is free forever for any
# team size, and with BILLING_ENABLED off none of it is read: no trial, no
# paywall, no seat limit, and the billing API is not even registered.
#
# It is here rather than hard-coded so the same compose file can run the
# paid configuration for testing. Only the exact string "true" switches it
# on — and then STRIPE_SECRET_KEY becomes required, and the backend
# refuses to start without it rather than running on and failing to charge.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=
BILLING_FREE_ORGANISATION_IDS=
# Public by design; inlined into the browser bundle at build time.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
